{
	"name": "flarum-lang/czech",
	"description": "Czech Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/czech",
	"license": "MIT",
	"authors": [
		{
			"name": "YelehaUwU",
			"homepage": "https://github.com/YelehaUwU",
			"role": "Maintainer"
		}
	],
	"support": {
		"issues": "https://github.com/flarum-lang/czech/issues",
		"forum": "https://discuss.flarum.org/d/35138",
		"source": "https://github.com/flarum-lang/czech"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
